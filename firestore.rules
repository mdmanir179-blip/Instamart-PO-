rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Connection test document
    match /test/connection {
      allow read, write: if true;
    }

    // Users collection for cross-team user directories
    match /users/{userId} {
      allow read, write: if true;
    }

    // Item Master catalog
    match /items/{itemId} {
      allow read, write: if true;
    }

    // Purchase Orders collection (real-time sync for Backoffice, Admin, Warehouse, Logistics, Print)
    match /purchase_orders/{poId} {
      allow read, write: if true;
    }

    // DN Records collection (real-time sync for Delivery Notes and Dispatch tracking)
    match /dn_records/{dnId} {
      allow read, write: if true;
    }
  }
}
